# halo resolves keys in this order: HALO_API_KEY -> DEEPSEEK_API_KEY -> OPENAI_API_KEY -> META_API_KEY
# Bun auto-loads this file when you run halo from this directory.
# The machine-wide store is ~/.halo/.env (created by halo's first-run onboarding).
HALO_API_KEY=

# For Meta (api.meta.ai) you can instead use:
# META_API_KEY=
# or MODEL_API_KEY (the name Meta's own examples use)

# Optional overrides (these win over ~/.halo/config.json):
# HALO_BASE_URL=https://api.deepseek.com/v1
# HALO_MODEL=deepseek-chat
# HALO_API=responses        # wire protocol: "chat-completions" (default) or "responses" (Meta)
